# ===========================================
# BUDGETS SYSTEM - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env file to version control!

# ===========================================
# SECURITY SETTINGS (CRITICAL)
# ===========================================
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-this-immediately

# Debug mode - NEVER set to True in production
DEBUG=False

# Allowed hosts - comma separated list
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS settings for API access
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_NAME=budgets_db
DB_USER=budgets_user
DB_PASSWORD=your-strong-database-password-here
DB_HOST=db
DB_PORT=5432

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PASSWORD=your-strong-redis-password-here

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@gmail.com

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# For production, consider using AWS S3 or similar
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===========================================
# MONITORING & HEALTH CHECKS
# ===========================================
HEALTH_CHECK_ENABLED=True
SENTRY_DSN=your-sentry-dsn-here

# ===========================================
# SSL/TLS CONFIGURATION
# ===========================================
SSL_ENABLED=True
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ===========================================
# CACHE CONFIGURATION
# ===========================================
CACHE_BACKEND=redis
CACHE_LOCATION=redis://:${REDIS_PASSWORD}@redis:6379/1

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_ENGINE=django.contrib.sessions.backends.cache
SESSION_CACHE_ALIAS=default
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# ===========================================
# CSRF CONFIGURATION
# ===========================================
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Strict

# ===========================================
# SECURITY HEADERS
# ===========================================
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ===========================================
# RATE LIMITING
# ===========================================
RATELIMIT_ENABLED=True
RATELIMIT_USE_CACHE=redis

# ===========================================
# BACKUP STORAGE
# ===========================================
BACKUP_STORAGE_TYPE=local  # or s3
BACKUP_STORAGE_PATH=/backups
